// Prisma schema for Pee Rahat — Phase 1 MVP.
// All persistent state lives here; apps/web never touches the DB.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity ──────────────────────────────────────────────────────────────

enum UserRole {
  student
  tutor
  parent
  admin
}

model User {
  id          String   @id @default(uuid())
  supabaseId  String   @unique
  email       String   @unique
  displayName String
  role        UserRole @default(student)
  avatarUrl   String?
  createdAt   DateTime @default(now())

  // Report system (FR-CM-05): lightweight moderation counters, only ever
  // incremented by ReportResolutionService — never auto-decremented.
  falseReportCount Int       @default(0)
  warningCount     Int       @default(0)
  // Set by suspension / ban resolutions. Checked in the auth guard so a
  // suspended user is blocked on their next request (stateless Supabase
  // JWT — no session table). suspension_perm / account_banned set the
  // year 2099 sentinel.
  suspendedUntil   DateTime?

  tutorProfile              TutorProfile?
  studentProfile            StudentProfile?
  kycSubmissions            KycSubmission[]
  bookingsAsStudent         Booking[]         @relation("StudentBookings")
  reviews                   TutorReview[]
  posts                     CommunityPost[]
  replies                   CommunityReply[]
  upvotes                   PostUpvote[]
  reports                   Report[]          @relation("ReportsFiled")
  notifications             Notification[]
  paymentIntents            PaymentIntent[]
  sentMessages              ChatMessage[]
  threadsAsStudent          ChatThread[]      @relation("StudentChat")
  loginAuditLogs            LoginAuditLog[]
  adminAuditLogs            AdminAuditLog[]   @relation("AdminAuditLogs")
  postponeRequestsInitiated PostponeRequest[]
  // FR-TH-18 group sessions: a user can be a host or invitee on any
  // number of bookings, and participates in any number of group chat
  // threads (1-on-1 threads still use the explicit student / tutor FKs).
  bookingParticipations     BookingParticipant[]
  chatThreadParticipations  ChatThreadParticipant[] @relation("ChatThreadParticipations")
}

model StudentProfile {
  userId        String    @id
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolGrade   String?
  pdpaConsentAt DateTime?
}

// ─── Tutors & KYC ──────────────────────────────────────────────────────────

enum KycStatus {
  not_started
  pending
  verified
  rejected
}

model TutorProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio           String
  university    String
  faculty       String
  hourlyRate    Int
  rating        Float    @default(0)
  reviewCount   Int      @default(0)
  defectCount   Int      @default(0)
  introVideoUrl String?
  isVerified    Boolean  @default(false)
  subjects      String[]
  createdAt     DateTime @default(now())

  // FR-TH-17: each tutor connects their own Google account via OAuth2;
  // the platform holds an encrypted refresh_token and mints Meet links on
  // their calendar at payment-confirm. googleRefreshToken IS NOT NULL is
  // a hard search-visibility gate — tutors without Google connected do
  // not appear in /tutors search results.
  googleRefreshToken String?
  googleEmail        String?
  googleConnectedAt  DateTime?

  // FR-TH-02 / FR-PM-06: bank account for manual PromptPay payouts.
  // Mirrored from the latest verified KycSubmission on admin approve so
  // PayoutsService can read it without a KYC join. bankAccountNumber is
  // AES-256-GCM encrypted; only last-4 digits appear in non-admin API
  // responses. bankAccountNumber IS NOT NULL is a search-visibility gate
  // alongside googleRefreshToken — tutors who can't be paid don't appear
  // in search.
  passbookObjectKey String?
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  bankUpdatedAt     DateTime?

  bookings       Booking[]
  reviews        TutorReview[]
  sheets         StudySheet[]
  threads        ChatThread[] @relation("TutorChat")
  payouts        Payout[]
  unavailability TutorUnavailability[]

  @@index([university])
  @@index([rating])
}

// FR-TH-16: tutor-marked weekly busy windows (lunch breaks, recurring
// commitments, etc.). Expanded into concrete intervals by the busy
// endpoint and the overlap guard.
model TutorUnavailability {
  id          String       @id @default(uuid())
  tutorId     String
  tutor       TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  weekday     Int          // 0=Sun … 6=Sat (matches JS Date.getDay)
  startMinute Int          // minutes since local midnight, 0..1440
  endMinute   Int          // strictly greater than startMinute
  reason      String?
  createdAt   DateTime     @default(now())

  @@index([tutorId])
}

model KycSubmission {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  idPhotoKey      String
  selfieKey       String
  transcriptKey   String
  // FR-TH-02: the legal name on the tutor's National ID. User types it
  // during onboarding (admin verifies against the ID photo at review).
  // bankAccountName must match this string (normalized) — payouts get
  // bounced if the name on the slip differs from the name on the ID.
  idName          String?
  // FR-TH-02 / FR-PM-06: passbook + bank info captured during onboarding.
  // Copied to TutorProfile on admin approval so payouts read without a
  // KycSubmission join. bankAccountNumber is AES-256-GCM encrypted at
  // rest via CryptoService — only the last 4 digits ever appear in
  // API responses outside the admin reveal endpoint.
  passbookObjectKey String?
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  status          KycStatus @default(pending)
  rejectionReason String?
  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  archivedAt      DateTime? // moved to cold storage (NFR-03)

  @@index([status])
}

// ─── Bookings ──────────────────────────────────────────────────────────────

enum BookingStatus {
  requested
  accepted
  rejected
  expired
  paid
  completed
  reported
  refunded
  cancelled
  postpone_pending
  postponed
  cancelled_no_agreement
  cancelled_tutor_unresponsive
  cancelled_tutor_initiated
}

// ─── FR-TH-18 group sessions ───────────────────────────────────────────────

enum SessionType {
  one_on_one
  group
}

// Group-only lifecycle. Null for one_on_one bookings.
//   forming      — host paid, waiting on invitees to accept their seats
//   tutor_review — every seat accepted; tutor decides go / no-go
//   confirmed    — tutor approved AND every invitee has paid; Meet generated
//   failed       — any failure mode; every paid participant 100% refunded
enum GroupStatus {
  forming
  tutor_review
  confirmed
  failed
}

enum ParticipantRole {
  host
  invited
}

// Per-seat lifecycle inside a group session. For 1-on-1 bookings the host's
// participant row mirrors booking.status (paid when the booking is paid,
// accepted otherwise) — see the FR-TH-18 backfill migration.
enum ParticipantStatus {
  invited
  accepted
  declined
  paid
  expired
}

model Booking {
  id                 String           @id @default(uuid())
  studentId          String
  student            User             @relation("StudentBookings", fields: [studentId], references: [id])
  tutorId            String
  tutor              TutorProfile     @relation(fields: [tutorId], references: [id])
  subject            String
  status             BookingStatus    @default(requested)
  scheduledAt        DateTime
  durationMinutes    Int
  amountThb          Int
  acceptDeadlineAt   DateTime
  reportWindowEndsAt DateTime?
  postponeRequestId  String?          @unique
  postponeRequest    PostponeRequest? @relation(fields: [postponeRequestId], references: [id])

  // FR-TH-17: auto-generated Google Meet link. Created inline at payment-
  // confirm on the tutor's own calendar via their connected Google account.
  // Cleared on postpone-confirm so the cloned booking regenerates fresh.
  // Admin can force-regenerate via POST /admin/bookings/:id/regenerate-meet.
  meetingUrl            String?
  googleCalendarEventId String?

  createdAt          DateTime         @default(now())

  // FR-TH-18: group session augmentations. For one_on_one bookings these
  // stay at their defaults (sessionType=one_on_one, capacity=1, every
  // group-only column null), so 1-on-1 callers see no behavioural change.
  // `amountThb` is the per-seat price — each participant pays their own.
  sessionType     SessionType  @default(one_on_one)
  capacity        Int          @default(1)
  groupStatus     GroupStatus?
  inviteCode      String?      @unique
  inviteExpiresAt DateTime?

  paymentIntent PaymentIntent?
  review        TutorReview?
  chatThread    ChatThread?
  refundLedgers RefundLedger[]
  participants  BookingParticipant[]

  @@index([tutorId, status])
  @@index([studentId, status])
  @@index([groupStatus])
}

// FR-TH-18: one row per seat in a booking. 1-on-1 bookings carry exactly
// one participant (role=host, studentId = the booking's student). Group
// bookings carry one host plus 2-9 invited rows up to `Booking.capacity`.
// PaymentIntent linkage flows through here for invitees so the existing
// `PaymentIntent.bookingId @unique` invariant (one host intent per booking)
// is preserved without disturbing the 1-on-1 PaymentsService path.
model BookingParticipant {
  id              String            @id @default(cuid())
  bookingId       String
  booking         Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  studentId       String
  student         User              @relation(fields: [studentId], references: [id])
  role            ParticipantRole
  status          ParticipantStatus @default(invited)
  paymentIntentId String?           @unique
  paymentIntent   PaymentIntent?    @relation(fields: [paymentIntentId], references: [id])
  invitedAt       DateTime          @default(now())
  acceptedAt      DateTime?
  paidAt          DateTime?

  @@unique([bookingId, studentId])
  @@index([bookingId, status])
  @@index([studentId])
}

model TutorReview {
  id        String       @id @default(uuid())
  bookingId String       @unique
  booking   Booking      @relation(fields: [bookingId], references: [id])
  studentId String
  student   User         @relation(fields: [studentId], references: [id])
  tutorId   String
  tutor     TutorProfile @relation(fields: [tutorId], references: [id])
  rating    Int
  text      String
  createdAt DateTime     @default(now())

  // Report system (content_removed resolution). Removed reviews are
  // excluded from public lists AND from the tutor rating average.
  removed       Boolean   @default(false)
  removedReason String?
  removedAt     DateTime?

  @@index([tutorId])
}

// ─── Sheet Marketplace ────────────────────────────────────────────────────

model StudySheet {
  id                     String       @id @default(uuid())
  sellerId               String
  seller                 TutorProfile @relation(fields: [sellerId], references: [id])
  title                  String
  description            String
  subject                String
  priceThb               Int
  rating                 Float        @default(0)
  reviewCount            Int          @default(0)
  pdfObjectKey           String
  previewImageObjectKeys String[]
  introVideoUrl          String?
  pageCount              Int          @default(0)
  isSuspended            Boolean      @default(false)
  createdAt              DateTime     @default(now())

  // Report system (content_removed resolution) — distinct from the
  // isSuspended copyright-takedown flag (FR-SM-07).
  removed       Boolean   @default(false)
  removedReason String?
  removedAt     DateTime?

  paymentIntents PaymentIntent[]

  @@index([subject])
  @@index([sellerId])
}

// ─── TCAS ──────────────────────────────────────────────────────────────────

enum TcasRoundKey {
  r1_portfolio
  r2_quota_kku_netsat
  r3_admission
  r4_direct
}

model TcasProgram {
  id            String   @id @default(uuid())

  university    String
  campus        String?
  faculty       String
  major         String
  subTrack      String?
  courseCode    String?
  programType   String?

  round         TcasRoundKey
  admissionYear Int
  quotaSeats    Int      @default(0)

  components    Json
  totalMinScore Float?

  tags          String[]
  sourceUrl     String?
  sourceFile    String?
  importedAt    DateTime?
  importedBy    String?

  @@unique([university, major, subTrack, programType, round, admissionYear], name: "tcas_program_identity")
  @@index([round, admissionYear])
  @@index([courseCode])
}

model TcasImportAudit {
  id         String   @id @default(uuid())
  kind       String   // "criteria-ai" | "criteria-csv" — set by the importer
  filename   String
  fileHash   String?
  inserted   Int      @default(0)
  updated    Int      @default(0)
  skipped    Int      @default(0)
  importedBy String?
  importedAt DateTime @default(now())

  @@index([importedAt])
}

// Per-call cost + token accounting for the Gemini PDF parser (and any
// future AI services). Powers the admin dashboard's monthly usage tile
// and gives us a paper trail if a parse goes wrong.
model AiUsageLog {
  id               String   @id @default(uuid())
  adminId          String
  service          String   // "tcas-parse"
  model            String
  promptTokens     Int
  completionTokens Int
  estimatedCostUsd Float
  durationMs       Int
  fileName         String?
  rowCount         Int?
  createdAt        DateTime @default(now())

  @@index([service, createdAt])
  @@index([adminId, createdAt])
}

model TcasDeadline {
  id    String   @id @default(uuid())
  title String
  date  DateTime
  type  String
}

// ─── Quiz ──────────────────────────────────────────────────────────────────

model QuizQuestion {
  id           String   @id @default(uuid())
  subject      String
  topic        String
  question     String
  options      String[]
  correctIndex Int

  @@index([subject])
}

model QuizSubmission {
  id         String   @id @default(uuid())
  userId     String
  subject    String
  scorePct   Float
  weakTopics String[]
  createdAt  DateTime @default(now())
}

// ─── Community ─────────────────────────────────────────────────────────────

model CommunityPost {
  id          String   @id @default(uuid())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  title       String
  content     String
  upvoteCount Int      @default(0)
  isHidden    Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Report system (content_removed resolution) — distinct from isHidden.
  removed       Boolean   @default(false)
  removedReason String?
  removedAt     DateTime?

  replies CommunityReply[]
  upvotes PostUpvote[]

  @@index([createdAt])
}

model CommunityReply {
  id        String        @id @default(uuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime      @default(now())

  // Report system (content_removed resolution).
  removed       Boolean   @default(false)
  removedReason String?
  removedAt     DateTime?

  @@index([postId])
}

model PostUpvote {
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  createdAt DateTime      @default(now())

  @@id([postId, userId])
}

// ─── Reports & moderation (report system, FR-CM-05 / FR-SM-07 / FR-PM-05) ──
// Polymorphic moderation reports across booking / chat / sheet / review /
// community-post targets. A reporter files; the resolved target owner is
// notified WITHOUT the reporter's identity; an admin manually reviews and
// resolves. Nothing is automatic except priority/SLA computation, rate
// limits, and the chat-bypass category nudge.

enum ReportTarget {
  booking
  chat_message
  sheet
  review
  community_post
}

enum ReportCategory {
  no_show
  fraud
  abuse
  harassment
  scam
  off_platform_solicitation
  fake_credentials
  impersonation
  inappropriate_content
  pirated_content
  quality_issue
  payment_issue
  spam
  misinformation
  other
}

enum ReportStatus {
  pending
  under_review
  escalated
  resolved
  rejected
  duplicate
}

enum ReportPriority {
  low
  normal
  high
  urgent
}

enum ReportResolution {
  no_action
  warning_issued
  suspension_temp
  suspension_perm
  refund_partial
  refund_full
  content_removed
  account_banned
  reporter_warned
}

model Report {
  id         String @id @default(cuid())
  reporterId String
  reporter   User   @relation("ReportsFiled", fields: [reporterId], references: [id])

  targetType   ReportTarget
  targetId     String       // polymorphic FK — resolved via TargetResolverService
  targetUserId String?      // resolved owner of the target, for notifications

  category     ReportCategory
  description  String   // 20–2000 chars (enforced in zod)
  evidenceKeys String[] // R2/S3 object keys, max 5

  status      ReportStatus   @default(pending)
  priority    ReportPriority @default(normal)
  slaDeadline DateTime

  assignedToId   String?
  resolvedAt     DateTime?
  resolution     ReportResolution?
  resolutionNote String? // internal admin note — never shown to the reporter
  publicResponse String? // visible to the reporter only

  linkedBookingId String? // chat/review/sheet report tied to a booking
  parentReportId  String? // duplicate clustering

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events ReportEvent[]

  @@index([status, priority, slaDeadline])
  @@index([targetType, targetId])
  @@index([reporterId, createdAt])
  @@index([targetUserId])
}

// Activity log for a report: reporter follow-up comments, admin-only
// internal notes, and timeline entries (status changes, assignment,
// resolution). One table — visibility is enforced per `kind` in the
// service layer (the reporter sees comments + timeline; admin sees all).
enum ReportEventKind {
  reporter_comment
  admin_note
  status_change
  assignment
  resolution
}

model ReportEvent {
  id           String          @id @default(uuid())
  reportId     String
  report       Report          @relation(fields: [reportId], references: [id], onDelete: Cascade)
  kind         ReportEventKind
  authorId     String?  // null for system-generated timeline entries
  text         String?  // comment / note body, or a timeline summary
  evidenceKeys String[] // attachments on reporter follow-up comments
  createdAt    DateTime        @default(now())

  @@index([reportId, createdAt])
}

// Minimal in-app notification feed. Built for the report system (target-
// user alerts, reporter updates, SLA pings) but kept generic for reuse.
// In-app only for Phase 1 — no email/push. A notification sent to a
// target user NEVER carries the reporter's identity.
enum NotificationType {
  report_filed
  report_under_review
  report_resolved
  report_warning
  report_suspension
  report_content_removed
  report_reporter_warned
  report_sla_overdue
  // FR-TH-18 group sessions. Emitted by GroupSessionService + the cron
  // failure jobs in step 10. See migration 20260525_group_notification_types.
  group_invite_responded
  group_ready_for_review
  group_decision
  group_status_changed
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  linkUrl   String?  // in-app deep link, e.g. /account/reports/:id
  reportId  String?  // the report that triggered this, if any
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// ─── Payments & Escrow ─────────────────────────────────────────────────────

enum PaymentItemType {
  booking
  sheet
}

enum PaymentStatus {
  pending_transfer
  slip_uploaded
  verifying
  // `verified` is deprecated — kept in the enum because Postgres cannot
  // drop enum values. No code path emits it; treat occurrences as data
  // that predates the manual-flow refactor.
  verified
  held_in_escrow
  released_for_payout // class done + report window passed; queued for next batch
  paid_out            // admin marked the manual PromptPay transfer to tutor done
  refunded
  failed
  disputed
  partially_refunded
}

enum PayoutStatus {
  pending     // queued for next batch
  in_progress // admin is processing
  completed   // money sent to tutor
  failed      // tutor account issue, etc.
}

model PaymentIntent {
  id                 String          @id @default(uuid())
  payerId            String
  payer              User            @relation(fields: [payerId], references: [id])
  itemType           PaymentItemType
  bookingId          String?         @unique
  booking            Booking?        @relation(fields: [bookingId], references: [id])
  sheetId            String?
  sheet              StudySheet?     @relation(fields: [sheetId], references: [id])
  amountThb          Int
  // FR-TH-11: pre-refund snapshot. Refunds shrink amountThb in place so
  // the payout batch picks up the surviving tutor portion unchanged;
  // originalAmountThb keeps the audit trail of what the student paid.
  originalAmountThb  Int?
  promptPayQrPayload String
  status             PaymentStatus   @default(pending_transfer)
  slipObjectKey      String?
  slipUploadedAt     DateTime?
  // FR-PM-02: ZercleSlip verification audit trail.
  // - transactionId is the bank transaction ref off the slip — used to
  //   block duplicate-slip submissions (one slip ≠ two paid bookings).
  // - zercleResponse is the full Zercle payload (sender, recipient,
  //   transferDate, raw OCR) for admin review and PDPA-friendly audit.
  transactionId      String?         @unique
  zercleResponse     Json?
  zercleVerifiedAt   DateTime?
  verifiedAmountThb  Int?
  failureReason      String?
  expiresAt          DateTime
  releasedAt         DateTime?
  payoutId           String?
  payout             Payout?         @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  refundLedgers      RefundLedger[]
  // FR-TH-18: backref. For 1-on-1 + the host's group intent this is the
  // single inverse of BookingParticipant.paymentIntentId; for invitee
  // intents PaymentIntent.bookingId stays null and the booking is reached
  // through BookingParticipant only.
  participant        BookingParticipant?
  createdAt          DateTime        @default(now())

  @@index([payoutId])
}

model Payout {
  id                String       @id @default(uuid())
  tutorId           String
  tutor             TutorProfile @relation(fields: [tutorId], references: [id])
  periodStart       DateTime
  periodEnd         DateTime
  grossThb          Int
  commissionThb     Int
  withholdingTaxThb Int
  netThb            Int
  scheduledAt       DateTime
  // FR-PM-06: admin-confirmed manual transfer tracking.
  status            PayoutStatus @default(pending)
  transferredAt     DateTime?
  transferredBy     String?      // admin User.id who confirmed the transfer
  transferSlipKey   String?      // R2/S3 object key for admin's transfer-proof slip
  notes             String?
  // Retained for the data already on disk; new flow uses transferredAt.
  // mark-transferred sets both for one release cycle of overlap.
  paidAt            DateTime?

  intents PaymentIntent[]
}

// ─── Chat ──────────────────────────────────────────────────────────────────

model ChatThread {
  id                String       @id @default(uuid())
  // FR-TH-18: studentId nullable so a group thread can omit the
  // 1-on-1 student-tutor pair. Postgres treats NULL as distinct in
  // unique constraints, so multiple group rows (null, tutorId) coexist
  // without colliding with each other or with 1-on-1 rows.
  studentId         String?
  student           User?        @relation("StudentChat", fields: [studentId], references: [id])
  tutorId           String
  tutor             TutorProfile @relation("TutorChat", fields: [tutorId], references: [id])
  bookingId         String?      @unique
  booking           Booking?     @relation(fields: [bookingId], references: [id])
  // FR-TH-18: discriminator. one_on_one threads keep using
  // studentLastReadAt / tutorLastReadAt; group threads read through the
  // ChatThreadParticipant junction table instead.
  sessionType       SessionType  @default(one_on_one)
  studentLastReadAt DateTime?
  tutorLastReadAt   DateTime?
  closedAt          DateTime?
  createdAt         DateTime     @default(now())

  messages     ChatMessage[]
  participants ChatThreadParticipant[]

  @@unique([studentId, tutorId])
}

// FR-TH-18: many-to-many between users and group threads. Authoritative
// for group threads. For 1-on-1 threads it's also backfilled so unread
// counts can use a single code path going forward, but the existing
// studentLastReadAt / tutorLastReadAt columns remain readable for now.
model ChatThreadParticipant {
  id         String     @id @default(cuid())
  threadId   String
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation("ChatThreadParticipations", fields: [userId], references: [id])
  lastReadAt DateTime?
  joinedAt   DateTime   @default(now())

  @@unique([threadId, userId])
  @@index([userId])
}

model ChatMessage {
  id        String          @id @default(uuid())
  threadId  String
  thread    ChatThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User            @relation(fields: [authorId], references: [id])
  body      String
  kind      ChatMessageKind @default(user)
  redacted  Boolean         @default(false)
  createdAt DateTime        @default(now())

  @@index([threadId, createdAt])
}

enum ChatMessageKind {
  user
  system
}

// ─── Audit log (NFR-05) ────────────────────────────────────────────────────

model LoginAuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  ip        String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// PDPA / Computer Crime Act: admin-side audit trail for sensitive
// surfaces (passbook view, bank reveal, etc.). Distinct from LoginAuditLog
// so the action / target columns can be queried directly without parsing
// userAgent strings. NFR-05 retention applies.
model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String
  admin      User     @relation("AdminAuditLogs", fields: [adminId], references: [id])
  action     String   // e.g. "view_passbook"
  targetType String   // "tutor" | "kyc" | "payout"
  targetId   String
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
}

// ─── Postpone-class negotiation (FR-TH-10..14) ────────────────────────────

enum PostponeInitiator {
  student
  tutor
}

enum PostponeStatus {
  negotiating
  agreed
  expired
}

enum PostponeOutcome {
  agreed
  no_agreement
  unresponsive
  tutor_initiated_no_agreement
}

model PostponeRequest {
  id               String            @id @default(uuid())
  booking          Booking?
  initiatorId      String
  initiator        User              @relation(fields: [initiatorId], references: [id])
  initiatorRole    PostponeInitiator
  reason           String
  chatExpiresAt    DateTime
  status           PostponeStatus    @default(negotiating)
  proposedAt       DateTime?
  proposedDuration Int?
  resolvedAt       DateTime?
  resolvedAs       PostponeOutcome?
  wasShortNotice   Boolean
  createdAt        DateTime          @default(now())

  @@index([status, chatExpiresAt])
}

enum RefundReason {
  postpone_short_notice_no_agreement
  postpone_unresponsive
  postpone_tutor_initiated_no_agreement
  admin_manual
  // FR-TH-18: group session failure modes. All three pay 100% refund to
  // every paid participant. No tutor defectCount increment.
  group_rejected_by_tutor
  group_invite_expired
  group_payment_incomplete
}

model RefundLedger {
  id                String        @id @default(uuid())
  paymentIntentId   String
  paymentIntent     PaymentIntent @relation(fields: [paymentIntentId], references: [id])
  bookingId         String
  booking           Booking       @relation(fields: [bookingId], references: [id])
  originalAmountThb Int
  studentRefundThb  Int
  tutorThb          Int
  platformThb       Int
  reasonCode        RefundReason
  // Set when the refund was issued by a report resolution (refund_partial /
  // refund_full). Null for postpone-driven refunds.
  reportId          String?
  createdAt         DateTime      @default(now())

  @@index([bookingId])
  @@index([paymentIntentId])
}
